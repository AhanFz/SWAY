# SERVER ONLY. Put these in Supabase Edge Function secrets; never EXPO_PUBLIC_.
# News collection needs no AI key. Any long random string works as the cron secret.
NEWS_CRON_SECRET=
# Share of significant headline words two reports must have in common to count as one story (0.3-1).
NEWS_SIMILARITY_THRESHOLD=0.6
FEED_HOST_ALLOWLIST=feeds.npr.org,www.aljazeera.com,feeds.bbci.co.uk,www.theguardian.com
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_ATTEST_ENV=production
ANDROID_PACKAGE_NAME=
ANDROID_CERTIFICATE_SHA256=
GOOGLE_SERVICE_ACCOUNT_JSON=
